{
  "Database": {
    "Provider": "sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=.notable-data/notable.db"
  },
  "Authentication": {
    "BuiltIn": {
      "Enabled": true,
      "AllowRegistration": true
    },
    "Oidc": {
      "Enabled": false
    }
  },
  "CouchDb": {
    "BaseUrl": "http://localhost:5984",
    "User": "admin",
    "Password": "admin"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
