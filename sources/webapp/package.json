    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "@tailwindcss/postcss": "^4.1.6",
    "events": "^3.3.0",
    "pouchdb-browser": "^9.0.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.6",
    "theme-change": "^2.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@eslint/js": "^10.0.1",
    "@types/pouchdb-browser": "^6.1.5",
    "angular-eslint": "22.6.0",
    "daisyui": "^5.0.35",
    "eslint": "^10.12.0",
    "jsdom": "^29.1.1",
    "nswag": "^14.7.1",
    "postcss": "^8.5.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
